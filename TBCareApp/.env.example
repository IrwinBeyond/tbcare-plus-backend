# ─────────────────────────────────────────────────────────────────────
# TBCare+ Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit the real .env file to source control.
# It is already listed in .gitignore.

# ── Supabase ─────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# The "anon" / publishable API key (not the service_role secret).
SUPABASE_KEY=your-anon-key-here

# JWT Secret used to verify Supabase-issued access tokens.
# Found in: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# (Optional) Service-role key for server-side operations.
# Only needed if the backend calls Supabase APIs that require elevated privileges.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string for the Supabase database.
# Use the "Session pooler" or "Transaction pooler" connection string
# from: Supabase Dashboard → Settings → Database → Connection Pooling
#
# Format:
#   Host=aws-0-xx-region.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxx;Password=your-db-password;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=Host=your-pooler-host.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
